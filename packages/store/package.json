{
  "name": "@munim/store",
  "version": "1.0.0",
  "private": true,
  "description": "Munim shared CLIENT-state store — Zustand factory for ephemeral UI state (active view/tab, global search, cross-view product filters, sell dialog). Server state lives in @munim/query (TanStack Query); this package never fetches.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "tsx test/smoke.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.0",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "react": "^19.2.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.1",
    "zustand": "^5.0.6"
  }
}
