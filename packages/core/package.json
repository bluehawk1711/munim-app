{
  "name": "@munim/core",
  "version": "1.0.0",
  "private": true,
  "description": "Munim shared core — Drizzle schema, Neon Postgres client, and ALL business logic (stock, sales, invoices, job letters, parties, advances/ledger, payments). Imported by the web, desktop, and mobile apps. No API server needed.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/db/server.d.ts",
      "import": "./dist/db/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "smoke": "esbuild scripts/smoke-test.mjs --bundle --platform=node --format=esm --outfile=scripts/.smoke-bundle.mjs && node scripts/.smoke-bundle.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "jspdf": "^2.5.2",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.1",
    "esbuild": "^0.28.2",
    "pg": "^8.23.0",
    "typescript": "^5.8.3"
  }
}
