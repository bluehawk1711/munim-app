# ── Munim API — environment (never commit the real .env) ─────────────

# Postgres connection string (Neon). Required.
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/munim?sslmode=require

# Port the API listens on. Default 4000.
PORT=4000

# ── Per-platform API keys (3) ─────────────────────────────────────────
# Each client is built with ONE of these injected at build time via GitHub
# Actions secrets (desktop → VITE_API_KEY, mobile → EXPO_PUBLIC_API_KEY,
# web → NEXT_PUBLIC_API_KEY). The server accepts any of the three.
API_KEY_WEB=replace-with-generated-web-key
API_KEY_DESKTOP=replace-with-generated-desktop-key
API_KEY_MOBILE=replace-with-generated-mobile-key

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser (the web
# app). Desktop (Tauri Rust fetch) and mobile (native fetch) don't need CORS.
# Leave empty to disable browser CORS entirely.
CORS_ORIGINS=https://your-web-app.example.com
