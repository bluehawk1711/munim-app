# ── Munim API — environment (never commit the real .env) ─────────────

# Postgres connection string (Neon). Required.
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/munim?sslmode=require

# Port the API listens on. Default 4000.
PORT=4000

# ── Per-platform API keys (3) ─────────────────────────────────────────
# Each client is built with ONE of these injected at build time via GitHub
# Actions secrets (desktop → VITE_API_KEY, mobile → EXPO_PUBLIC_API_KEY,
# web → NEXT_PUBLIC_API_KEY). The server accepts any of the three.
API_KEY_WEB=replace-with-generated-web-key
API_KEY_DESKTOP=replace-with-generated-desktop-key
API_KEY_MOBILE=replace-with-generated-mobile-key

# ── CORS ─────────────────────────────────────────────────────────────
# Disabled — the API allows ALL origins (auth is per-request via x-api-key).
# Do not rely on CORS for security.

# ── Cloudinary (server-side signed image uploads) ─────────────────────
# The API proxies product-image uploads so the secret never reaches clients.
# Optional: /api/upload returns 503 when unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Upstash Redis (REST) ──────────────────────────────────────────────
# Both must be set to enable the shared cache layer (cache-aside reads +
# explicit invalidation on writes). When unset the API falls back to an
# in-process TTL cache — fine for local dev, but set these in production
# (especially with multiple API replicas).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
