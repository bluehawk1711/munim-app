# ── Munim web app (apps/web) ──────────────────────────────────────────────────
# The web app talks to the shared NestJS API (apps/api) through @munim/api-client
# — there are no local /api routes anymore (Phase 6 complete). These vars are
# inlined at build time; set them on Vercel too.

# Where the NestJS API lives.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# The web platform key the server accepts (x-api-key). Generate with
# `openssl rand -hex 32` and set the matching API_KEY_WEB on the server.
NEXT_PUBLIC_API_KEY=""

# The deployed web origin must also be listed in the server's CORS_ORIGINS
# for browser calls to succeed.
