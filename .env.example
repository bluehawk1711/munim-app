# ── Shared Neon Postgres (used by ALL apps through packages/core) ─────────────
# Create a project at https://neon.tech → copy the pooled connection string.
# NOTE: for the mobile/desktop apps this URL's credentials are embedded in the
# client — create a dedicated read/write role with least privilege instead of
# using your account's primary role.
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/munim?sslmode=require

# Optional: plain SQL-over-HTTP credentials (user:password or role+api key).
# If DATABASE_AUTH_TOKEN is set, core uses Bearer auth, otherwise Basic auth
# derived from DATABASE_URL.
DATABASE_AUTH_TOKEN=

# ── Web app (apps/web) ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Tauri desktop (apps/desktop) ──────────────────────────────────────────────
# The desktop app reads DATABASE_URL from this file at build/dev time and
# embeds it via the Vite define. Keep the same values as above.

# ── Expo mobile (apps/mobile) ─────────────────────────────────────────────────
# Same shared connection string. EXPO_PUBLIC_ vars are inlined by Expo.
EXPO_PUBLIC_DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/munim?sslmode=require
EXPO_PUBLIC_DATABASE_AUTH_TOKEN=
