# ── Munim monorepo environment ────────────────────────────────────────────────
# The apps no longer talk to Neon directly — everything goes through the shared
# NestJS API (apps/api), which owns the DB (packages/core). See
# docs/nestjs-backend.md for the full migration status.

# ── API server (apps/api) ─────────────────────────────────────────────────────
# Create a project at https://neon.tech → copy the connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/munim?sslmode=require

# Port the API listens on (default 4000).
PORT=4000

# Per-platform API keys — each client sends one of these as the x-api-key
# header; the server rejects requests with an unknown key. Generate long
# random strings (e.g. `openssl rand -hex 32`).
API_KEY_WEB=
API_KEY_DESKTOP=
API_KEY_MOBILE=

# Comma-separated browser origins allowed to call the API (required for the
# web app in the browser; desktop/mobile calls are not subject to CORS).
# Example: https://munim.vercel.app,http://localhost:3000
CORS_ORIGINS=

# Cloudinary (product image uploads) — server-side SIGNED uploads, so the
# secrets never reach any client. Dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis REST (optional caching layer). When both are set the API
# caches GETs (cache-aside) and invalidates on writes; when unset it falls
# back to an in-process TTL cache (fine for a single instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Web app (apps/web) — build-time env ───────────────────────────────────────
# Where the API lives + the web platform key (baked into the client bundle).
# Set the same values on Vercel (Project → Settings → Environment Variables)
# and list the deployed web origin in CORS_ORIGINS above.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_KEY=

# ── Tauri desktop (apps/desktop) — build-time env ─────────────────────────────
# Baked into the installer by the desktop-build GitHub Actions workflow
# (secrets VITE_API_URL / VITE_API_KEY / VITE_CLOUDINARY_CLOUD_NAME /
# VITE_CLOUDINARY_UPLOAD_PRESET). Users can still override the URL/key in
# onboarding or Settings (stored in localStorage).
VITE_API_URL=http://localhost:4000
VITE_API_KEY=
# Cloudinary direct-upload FALLBACK (unsigned preset — see below).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── Expo mobile (apps/mobile) — build-time env ────────────────────────────────
# Baked into the APK by the mobile-build GitHub Actions workflow (secrets
# EXPO_PUBLIC_API_URL / EXPO_PUBLIC_API_KEY / EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME /
# EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET). EXPO_PUBLIC_ vars are inlined by Expo
# — they ship in the client, so use the mobile platform key only.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Cloudinary client fallback (desktop + mobile) ─────────────────────────────
# Product images upload through the API (server-side signed, CLOUDINARY_*
# above). As a fallback when the API's upload is unavailable, desktop + mobile
# can upload DIRECTLY to Cloudinary using an UNSIGNED upload preset baked in at
# build time (Settings → Upload → Upload presets → Add, set "unsigned"). Never
# bake the API secret into a client build — unsigned presets are public by
# design and only allow uploads to your cloud.
#
# GitHub Actions secrets to create for the workflows:
#   desktop-build.yml: VITE_API_URL, VITE_API_KEY, VITE_CLOUDINARY_CLOUD_NAME,
#                      VITE_CLOUDINARY_UPLOAD_PRESET
#   mobile-build.yml:  EXPO_PUBLIC_API_URL, EXPO_PUBLIC_API_KEY,
#                      EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME,
#                      EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET
