{
  "name": "munim",
  "version": "1.0.0",
  "private": true,
  "description": "Munim — shop management monorepo (stock, billing, advances/ledger) for web, desktop & mobile",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@munim/web",
    "dev:desktop": "turbo run dev --filter=@munim/desktop",
    "dev:mobile": "turbo run dev --filter=@munim/mobile",
    "build": "turbo run build",
    "build:core": "turbo run build --filter=@munim/core",
    "build:mobile:android": "pnpm --filter @munim/mobile build:android",
    "build:mobile:release": "pnpm --filter @munim/mobile build:android:release",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @munim/core db:generate",
    "db:migrate": "pnpm --filter @munim/core db:migrate",
    "db:push": "pnpm --filter @munim/core db:push",
    "db:smoke": "pnpm --filter @munim/core smoke",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "core-js",
      "unrs-resolver"
    ]
  }
}
